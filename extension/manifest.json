{
  "manifest_version": 3,
  "name": "Stride: Algorithm Lab",
  "short_name": "Stride",
  "version": "3.1.0",
  "description": "Step through BFS, Dijkstra, A*, sorts, searches, spanning trees, k-means and gradient descent with the live data structures beside them.",
  "homepage_url": "https://mahan-imanian.github.io/stride/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Stride",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
